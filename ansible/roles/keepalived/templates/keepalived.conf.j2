{% set index = ansible_play_hosts_all.index(inventory_hostname) %}
vrrp_instance VI_1 {
    state {{ 'MASTER' if index == 0 else 'BACKUP' }}
    interface eth1
    virtual_router_id 51
    priority {{ 101 - index }}
    advert_int 1

    authentication {
        auth_type PASS
        auth_pass {{ keepalived_auth_pass }}
    }

    virtual_ipaddress {
      {{ keepalived_vip }}/24 dev eth1 label eth1:vip
    }
}
